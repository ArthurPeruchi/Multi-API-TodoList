
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id     Int      @id @default(autoincrement())
  nome   String
  email  String   @unique
  senha  String
  tarefas Tarefa[]

  @@map("usuarios")
}

model Tarefa {
  id        Int     @id @default(autoincrement())
  titulo    String
  concluida Boolean @default(false)
  usuarioId Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tarefas")
}